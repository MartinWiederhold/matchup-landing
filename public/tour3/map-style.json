{
  "version": 8,
  "name": "matchup-tour3-warm",
  "metadata": {
    "matchup:purpose": "Reduzierte, warme Kartenbühne für /tour3. Die Karte tritt bewusst zurück, damit die Saisonroute der Held ist. Kein POI, keine Straßen unter Zoom 12, sehr kleine sparsame Beschriftung.",
    "matchup:source": "Basiert auf OpenMapTiles-Vektorkacheln von OpenFreeMap (kein API-Key, kommerziell frei nutzbar)."
  },
  "sources": {
    "openmaptiles": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#FBF9F4" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "minzoom": 4,
      "paint": {
        "fill-color": "#F1EBDD",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "minzoom": 6,
      "paint": {
        "fill-color": "#F3EDDF",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "minzoom": 9,
      "paint": {
        "fill-color": "#F5F0E5",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "park"],
      "minzoom": 8,
      "paint": {
        "fill-color": "#EDE7D6",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", "intermittent", 1],
      "paint": {
        "fill-color": "#D6DBDE",
        "fill-antialias": true
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 7,
      "paint": {
        "line-color": "#C7CDD1",
        "line-width": { "stops": [[7, 0.4], [12, 1.0], [16, 2.0]] }
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 2], ["!=", "maritime", 1]],
      "paint": {
        "line-color": "#C8C0AE",
        "line-width": { "stops": [[0, 0.4], [6, 0.8], [10, 1.1]] },
        "line-opacity": 0.85,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 4], ["!=", "maritime", 1]],
      "minzoom": 5,
      "paint": {
        "line-color": "#D4CDBB",
        "line-width": { "stops": [[5, 0.3], [10, 0.6]] },
        "line-opacity": 0.7,
        "line-dasharray": [4, 3]
      }
    },
    {
      "id": "place-country-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "country"],
      "minzoom": 2,
      "maxzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:de"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": { "stops": [[2, 9], [4, 11], [6, 13]] },
        "text-transform": "uppercase",
        "text-letter-spacing": 0.14,
        "text-max-width": 8,
        "text-padding": 8
      },
      "paint": {
        "text-color": "#4A4640",
        "text-halo-color": "#FBF9F4",
        "text-halo-width": 1.2,
        "text-opacity": 0.85
      }
    },
    {
      "id": "place-city-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", "class", "city"], [">=", "rank", 1], ["<=", "rank", 6]],
      "minzoom": 5,
      "layout": {
        "text-field": ["coalesce", ["get", "name:de"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": { "stops": [[5, 10], [8, 12]] },
        "text-max-width": 8,
        "text-padding": 6
      },
      "paint": {
        "text-color": "#5A554D",
        "text-halo-color": "#FBF9F4",
        "text-halo-width": 1.2,
        "text-opacity": 0.8
      }
    }
  ]
}
